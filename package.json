{
  "name": "yuer-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "node scripts/prerender-pages.mjs && node scripts/gen-feed.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "validate": "node scripts/validate-content.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.mjs",
    "lint": "eslint src --ext .js,.vue",
    "format": "prettier --write src scripts",
    "check": "npm run validate && npm run lint && npm run check:perf-budget && npm run build"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "kb-ui-vue": "^0.4.2",
    "markdown-it": "^15.0.2",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.4"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  }
}
